# ---------------------------------------------------------------------------
# AI assistant (optional)
# ---------------------------------------------------------------------------
# The assistant is off until these are set. Nothing here is ever shipped to the
# browser: only the serverless function in `api/chat.ts` (and the dev-server
# middleware that mirrors it) reads them.
#
# Any OpenAI-compatible /chat/completions endpoint works. Free options:
#
#   Google AI Studio   free tier, no credit card, fastest to set up
#                      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                      AI_MODEL=gemini-2.5-flash
#                      key: https://aistudio.google.com/apikey
#
#   Groq               free tier, very fast inference
#                      AI_BASE_URL=https://api.groq.com/openai/v1
#                      AI_MODEL=llama-3.3-70b-versatile
#                      key: https://console.groq.com/keys
#
#   OpenRouter         free models are suffixed with `:free`
#                      AI_BASE_URL=https://openrouter.ai/api/v1
#                      AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#                      key: https://openrouter.ai/keys
#
#   Ollama (local)     zero cost, no key, needs the model pulled locally
#                      AI_BASE_URL=http://localhost:11434/v1
#                      AI_MODEL=llama3.2
#
# Copy this file to `.env` for local development, and set the same names in
# the Vercel project's Environment Variables for the deployed site.

# Endpoint, without the trailing /chat/completions.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Leave empty for a local model server (Ollama); required for hosted providers.
AI_API_KEY=

# The model id as the provider spells it.
AI_MODEL=gemini-2.5-flash

# Optional. Overrides the provider name shown in the chat header.
# AI_PROVIDER_LABEL=Google AI Studio
