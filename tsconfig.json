{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        // No `baseUrl`: it is deprecated and stops working in TypeScript 7.
        // Since TS 4.1 `paths` resolves relative to this file, so `./src/*` is
        // equivalent to `src/*` under `baseUrl: "."` — and the alias itself is
        // also declared in vite.config.ts, which is what actually resolves it
        // at build time.
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "api", "server", "vite.config.ts"]
}
